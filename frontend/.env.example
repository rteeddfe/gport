NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# HMAC secret of the test-acquiring webhook — must equal the backend's
# PAYMENTS_WEBHOOK_SECRET while the emulator is enabled (the frontend route
# handler signs the emulator's callback). Dev falls back to a fixed dev
# secret; a production deploy must set the same long random value on both
# apps.
PAYMENTS_WEBHOOK_SECRET=
