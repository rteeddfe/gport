# Copy to .env and fill in real values. Never commit .env.
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/marketplace
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
# Set to "1" when running behind one reverse-proxy hop (PaaS), so the rate
# limiter sees real client IPs. Leave empty for direct local access.
TRUST_PROXY=
# Cookie SameSite policy: "Lax" (default) when the site and the API share a
# host; "None" when they live on different hosts (forces Secure on cookies).
COOKIE_SAME_SITE=
# HMAC secret of the test-acquiring webhook — must match the frontend route
# handler that plays the emulator's server side. Set a long random value in
# production (dev falls back to a fixed dev secret).
PAYMENTS_WEBHOOK_SECRET=
# Absolute origin of the storefront — the base of payment redirect URLs.
# Optional: falls back to the first CORS_ORIGIN entry.
STOREFRONT_ORIGIN=
# OAuth providers (M-OAUTH). Empty client id = provider disabled.
# SINCE M-INTEGRATIONS-2 these are the FALLBACK only: used while no DB
# integration exists. Once an integration is saved in the admin panel
# (Админка → Настройки → Интеграции), the DB is authoritative — ENV is
# ignored, even when DB says disabled or incomplete.
# Register separate apps per environment (dev / prod); the redirect URI
# must exactly match an entry in the provider app settings.
# Yandex allows localhost on any port; VK ID only allows http://localhost
# (port 80) or https://localhost (port 443).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=
# Master key of the integration secrets vault (M-INTEGRATIONS) — hex of
# exactly 32 bytes. Encrypts integration credentials (OAuth client
# secrets, API keys...) at rest with AES-256-GCM. Empty in development =
# the vault is locked (saving secrets fails); REQUIRED in production
# (the backend refuses to start). Generate: openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY=
