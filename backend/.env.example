# Copy to .env and fill in real values. Never commit .env.
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/marketplace
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
# Set to "1" when running behind one reverse-proxy hop (PaaS), so the rate
# limiter sees real client IPs. Leave empty for direct local access.
TRUST_PROXY=
# Cookie SameSite policy: "Lax" (default) when the site and the API share a
# host; "None" when they live on different hosts (forces Secure on cookies).
COOKIE_SAME_SITE=
